<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kuka_drivers_core</name>
  <version>1.1.0</version>
  <description>Package containing ROS2 core functions for KUKA robots</description>
  <maintainer email="tamas.pepo@kuka.com">Tamas Pepo</maintainer>
  <maintainer email="aron.svastits@kuka.com">Aron Svastits</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>lifecycle_msgs</depend>
  <depend>controller_manager</depend>
  <depend>hardware_interface</depend>
  <depend>controller_manager_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
